# Copy to .env for local development:  cp .env.example .env
# Never commit .env. In production these come from GitHub Secrets (see DEPLOYMENT.md).

# --- Firebase web config (browser) -------------------------------------------
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
# These identify the project and are public by design; data is protected by
# Firebase Auth + firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional: enables the "Run now on GitHub" link (owner/repo)
VITE_GITHUB_REPO=AalapHarathi/Job-Search
# Local dev serves from "/"; the deploy workflow sets /Job-Search/ automatically.
VITE_BASE_PATH=/

# --- Server-side only (refresh job: npm run refresh / refresh:dry) -----------
# NEVER prefix these with VITE_ — anything with VITE_ is bundled into the browser.
# FIREBASE_SERVICE_ACCOUNT=   (whole service-account JSON on one line)
# OWNER_UIDS=                 (your Firebase Auth UID; comma-separate several)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# REED_API_KEY=
# LLM_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=
# SMTP_URL=
# NOTIFY_EMAIL=
